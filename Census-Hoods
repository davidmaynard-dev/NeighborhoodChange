readRenviron("~/.Renviron") # First time, reload your environment so you can use the key without restarting R.
Sys.getenv("census_api_key") #check to make sure your key loaded correctly
year <- 2024
geo_select <- "PA"
vars <- load_variables(2024, "acs5")


# Read the CSV file of census codes you want to pull into a data frame
# Extract the column as a vector

df <- read.csv("Data2024.csv")
ask <- df$Code


# For each row in the code column of the csv, download the census field for your selected geometries.
PA_acs <- get_acs(state = geo_select, county = c("Allegheny"), 
                       geography = "tract", year = year, 
                       variables = c(ask),
                       output = "wide",
                       geometry = FALSE) %>% 
  dplyr::select(!ends_with("M"))

# Import the Conversion csv, ensure GEOID is set to Character
library(readr)
convert <- read_csv("x2020.csv", col_types = cols(GEOID = col_character()))

# Join the conversion csv table with your census data, multiply each row against the conversion %.
Hood <- PA_acs %>%
  left_join(convert, by = "GEOID") %>%
  mutate(
    across(
      .cols = ends_with("E") & !NAME,
      .fns = list(mod = ~ .x * Conversion),
      .names = "{.col}mod"
    )
  )

# Aggregate all fields by the neighborhood tag in the conversion csv, creating a row for each hood.
Hoodtotals <- summarise(
  group_by(Hood, Neighborhood),
  across(
    .cols = ends_with("mod"),
    .fns = list(sum = ~ sum(.x, na.rm = TRUE)),
    .names = "{.col}"
  )
)

# Export a CSV of your results!
write_csv(Hoodtotals, "Hoodtotals.csv")
